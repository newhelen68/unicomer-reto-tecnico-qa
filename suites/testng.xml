<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite completa">
    <listeners>
        <listener class-name="com.unicomer.qa.listeners.TestListener"/>
    </listeners>

    <test name="UI">
        <groups>
            <run>
                <exclude name="known-defect"/>
            </run>
        </groups>
        <classes>
            <class name="com.unicomer.qa.ui.CreditCalculatorTest"/>
        </classes>
    </test>

    <test name="API">
        <classes>
            <class name="com.unicomer.qa.api.CatFactsApiTest"/>
        </classes>
    </test>
</suite>
